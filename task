#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")"

function build {
  if [[ $# -eq 0 ]]; then rm -rf www; fi
  deno run -A tools/build.js "$@"
}

function size {
  deno run -A tools/size.js "$@"
}

function media {
  deno run -A tools/media.js "$@"
  build "$@"
}

function record {
  deno run -A tools/record.js "$@"
  media "$@"
}

function clean {
  for dir in media/*/; do
    [[ -d "$dir" ]] || continue
    game=$(basename "$dir")
    if [[ -f "src/$game.js" ]]; then continue; fi
    echo "$game"
    rm -rf "$dir"
  done
}

function fmt {
  deno fmt
  deno lint
}

function deploy {
  build
  rsync -a --delete --partial --progress www/ metaphora:one/
  git push
}

function help {
  echo "$0 <task> <args>"
  echo "Tasks:"
  compgen -A function | grep -v "^_" | cat -n
}

TIMEFORMAT="Task completed in %3lR"
time "${@:-help}"
